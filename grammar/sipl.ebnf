(* ======================================================================
   SIPL - формальна граматика ЯДРА МОВИ КУРСУ, версія 2.0 (ISO-EBNF)
   ----------------------------------------------------------------------
   Джерело: М.С. Нікітченко, «Теорія програмування», 2020, табл. 1.4 (с. 10);
   Практикум, практична робота 1.

     P ::= begin S end                                                   P1
     S ::= x := a | S1 ; S2 | if b then S1 else S2 | while b do S
         | begin S end | skip                                            S1-S6
     a ::= n | x | a1 + a2 | a1 - a2 | a1 * a2 | (a)                     A1-A6
     b ::= a1 = a2 | a1 > a2 | b1 ∨ b2 | ¬b | (b)                        B1-B5
     x ::= ... M | N | ...                                               NV
     n ::= ... -1 | 0 | 1 | 2 | 3 | ...                                  NN

   БНФ курсу неоднозначна. Підручник (с. 9-10) усуває неоднозначність
   пріоритетами (у порядку зменшення): *; + -; = >; ¬; ∨; :=; while; if; ;
   і лівою асоціативністю всіх бінарних операцій. Нижче - еквівалентна
   однозначна (стратифікована) форма: це «друга можливість досягти
   однозначності - ввести нові метасимволи», запропонована на с. 10.
   Вона породжує ту саму мову, що й БНФ курсу.

   Наслідки пріоритетів, закладені в правила:
     * гілки if і тіло while - один оператор (while/if сильніші за ;),
       тому  if b then S1 else S2; S3  =  (if b then S1 else S2); S3
     * S1; S2; S3 = (S1; S2); S3,   a1 - a2 - a3 = (a1 - a2) - a3
     * ¬ a1 = a2  =  ¬(a1 = a2)  (порівняння сильніше за ¬)

   Термінали: "..." - канонічний вид токена (див. LEXICAL.md: "-" також
   приймає "–" і "−", "*" - "∗", "or" - "∨", "not" - "¬");
   IDENT - змінна, NUMBER - послідовність цифр.

   Розширення, якими користується практикум (≥, <, div, mod, ...), задані
   окремо у sipl-ext.ebnf.
   ====================================================================== *)

program    = "begin" , stmt_seq , "end" ;                      (* P1 *)

stmt_seq   = statement , { ";" , statement } ;                 (* S2 *)

statement  = assignment                                        (* S1 *)
           | if_stmt                                           (* S3 *)
           | while_stmt                                        (* S4 *)
           | block                                             (* S5 *)
           | skip_stmt ;                                       (* S6 *)

assignment = IDENT , ":=" , aexpr ;
if_stmt    = "if" , bexpr , "then" , statement , "else" , statement ;
while_stmt = "while" , bexpr , "do" , statement ;
block      = "begin" , stmt_seq , "end" ;
skip_stmt  = "skip" ;

(* арифметичні вирази *)
aexpr      = term , { addop , term } ;                         (* A3, A4 *)
term       = factor , { mulop , factor } ;                     (* A5 *)
factor     = number                                            (* A1 *)
           | IDENT                                             (* A2 *)
           | "(" , aexpr , ")" ;                               (* A6 *)
number     = [ "-" ] , NUMBER ;                                (* NN: ... -1 | 0 | 1 ... *)
addop      = "+" | "-" ;
mulop      = "*" ;

(* умови *)
bexpr      = bterm , { "or" , bterm } ;                        (* B3 *)
bterm      = bfactor ;            (* кон'юнкції в ядрі немає; правило збігається
                                     за структурою з sipl-ext.ebnf *)
bfactor    = "not" , bfactor                                   (* B4 *)
           | "(" , bexpr , ")"                                 (* B5 *)
           | comparison ;
comparison = aexpr , relop , aexpr ;                           (* B1, B2 *)
relop      = "=" | ">" ;
